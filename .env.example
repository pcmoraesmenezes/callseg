# Copie para .env e troque as senhas. O .env nunca vai para o git.
POSTGRES_USER=segmenter
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=segmenter
# Senha do papel bi_reader, que só lê agregados (o Metabase usa este papel)
BI_PASSWORD=troque-esta-senha-do-leitor

# Portas no 127.0.0.1 da máquina
API_PORT=8010
BI_PORT=3010
MLFLOW_PORT=5010
AIRFLOW_PORT=8080

# Metabase: conta de administração criada na primeira execução do provisionamento
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=troque-esta-senha-do-metabase

# MLflow atrás de senha: gere o hash com `make mlflow-login`
MLFLOW_BASIC_USER=visitante
MLFLOW_BASIC_HASH=

# Opcional: modelo candidato em modo sombra (caminho dentro do contêiner da API) e aviso de deriva por Telegram
SHADOW_MODEL_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
